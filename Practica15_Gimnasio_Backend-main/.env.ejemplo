# Copia este archivo como .env y cambia TU_PASSWORD por la contrasena
# de root de tu MySQL. La base "gimnasio_web" no hace falta crearla a mano:
# `prisma migrate dev` la crea si no existe. Es OTRA base distinta a la
# "gimnasio" de la Unidad II, para no chocar con sus migraciones.
DATABASE_URL="mysql://root:TU_PASSWORD@localhost:3306/gimnasio_web"

# Quien tenga este secreto puede firmar tokens validos. Cambialo.
JWT_SECRET="cambia-esto-por-algo-largo-y-aleatorio"

# Solo para el despliegue: la URL publica del frontend (Netlify).
# FRONTEND_URL="https://tu-sitio.netlify.app"
# Solo para el despliegue con Aiven: la base pide conexion cifrada.
# DB_SSL="true"
